{
  "manifest_version": 3,
  "name": "LinkedIn Sender",
  "version": "1.0",
  "description": "Send LinkedIn messages from Thoughtful leads",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.linkedin.com/*", "https://www.thoughtful.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Sender"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
